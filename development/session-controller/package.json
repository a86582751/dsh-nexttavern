{
  "name": "dsh-nexttavern-session-controller",
  "version": "0.3.0-dev.1",
  "private": true,
  "description": "NextTavern maintained Session Controller with pre-publication fork reservation and native client contracts",
  "type": "module",
  "license": "GPL-3.0-only",
  "exports": {
    ".": "./lib/index.js",
    "./types": "./lib/types.js",
    "./typert": "./lib/typert.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "LICENSE",
    "ORIGIN.json",
    "LICENSE.upstream"
  ],
  "dependencies": {
    "mime-db": "1.54.0",
    "mime-types": "3.0.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-brand": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-deque": ">=0.2.2-rc.5",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.2-rc.5",

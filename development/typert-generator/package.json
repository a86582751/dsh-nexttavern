{
  "name": "@deepseek-ai/dsh-typert-generator",
  "description": "NextTavern pinned upstream Typert analyzer and emitter; not an upstream release",
  "version": "0.1.7-rc.2",
  "private": true,
  "publishConfig": {"access": "public"},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/typert/generator"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {"types": "./src/index.ts", "default": "./lib/index.js"},
    "./tsdown": {"types": "./src/tsdown-plugin.ts", "default": "./lib/tsdown-plugin.js"},
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["src", "lib", "LICENSE", "LICENSE.upstream", "ORIGIN.md"],
  "license": "MIT",
  "dependencies": {
    "@jridgewell/gen-mapping": "0.3.13",
    "typescript": "6.0.3"
  },
  "peerDependencies": {"@deepseek-ai/cordis": "~4.0.4"},
  "devDependencies": {
    "@deepseek-ai/dsh-tool-cordis": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.7-rc.2",
    "@deepseek-ai/cordis": "~4.0.4",
    "zod": "^4.4.3"
  }
}

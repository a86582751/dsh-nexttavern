{
  "name": "@deepseek-ai/dsh-llm",
  "description": "NextTavern maintained DSH LLM compat fork; not an upstream release",
  "version": "0.1.7-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./src/invariant.ts", "default": "./lib/invariant.js" },
    "./types": { "types": "./src/types.ts", "default": "./lib/types.js" },
    "./brand": { "types": "./src/brand.ts", "default": "./lib/brand.js" },
    "./message": { "types": "./src/message.ts", "default": "./lib/message.js" },
    "./assistant-stream": { "types": "./src/assistant-stream.ts", "default": "./lib/assistant-stream.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["src", "lib", "LICENSE", "LICENSE.upstream", "NOTICE", "ORIGIN.json"],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.7-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "zod": "^4.4.3"
  },
  "private": true
}

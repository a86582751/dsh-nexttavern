{
  "name": "dsh-nexttavern-pi-ai",
  "version": "0.3.0-dev.1",
  "description": "NextTavern pi-ai 0.85.1 minimal terminal compatibility candidate; not an upstream release",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "sideEffects": [
    "./lib/compat.js",
    "./lib/images.js",
    "./lib/providers/images/register-builtins.js"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./compat": {
      "types": "./lib/compat.d.ts",
      "import": "./lib/compat.js"
    },
    "./providers/*": {
      "types": "./lib/providers/*.d.ts",
      "import": "./lib/providers/*.js"
    },
    "./api/*": {
      "types": "./lib/api/*.d.ts",
      "import": "./lib/api/*.js"
    },
    "./utils/*": {
      "types": "./lib/utils/*.d.ts",
      "import": "./lib/utils/*.js"
    },
    "./oauth": {
      "types": "./lib/oauth.d.ts",
      "import": "./lib/oauth.js"
    },
    "./bedrock-provider": {
      "types": "./lib/bedrock-provider.d.ts",
      "import": "./lib/bedrock-provider.js"
    },
    "./bun-oauth": {
      "types": "./lib/bun-oauth.d.ts",
      "import": "./lib/bun-oauth.js"
    }
  },
  "files": [
    "lib",
    "src",
    "LICENSE",
    "LICENSE.upstream",
    "ORIGIN.json",
    "NOTICE"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@aws-sdk/client-bedrock-runtime": "3.1048.0",
    "@earendil-works/pi-telemetry": "0.85.1",
    "@google/genai": "1.52.0",
    "@smithy/node-http-handler": "4.7.3",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "openai": "6.40.0",
    "partial-json": "0.1.7",
    "typebox": "1.3.7"
  },
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "bedrock",
    "unified",
    "api"
  ],
  "author": "Mario Zechner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a86582751/pi.git",
    "directory": "packages/ai"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "private": true,
  "homepage": "https://github.com/a86582751/pi"
}

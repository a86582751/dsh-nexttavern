              "html": "<!doctype html>\n<html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>弥潮港 · 港口值班台</title><style>\n:root{color-scheme:dark;--sea:#112c36;--copper:#be925b;--paper:#edf0dd;--foam:#8fc8c3;--alarm:#d96d50}\n*{box-sizing:border-box}body{margin:0;background:var(--sea);color:var(--paper);font:15px/1.65 system-ui,\"Microsoft YaHei\",sans-serif}\n.watch{max-width:940px;margin:auto;padding:24px;border:1px solid var(--copper)}\nheader{display:flex;align-items:baseline;justify-content:space-between;gap:16px;border-bottom:1px solid #be925b66;padding-bottom:16px}\nh1,h2{font-family:\"Noto Serif CJK SC\",\"Songti SC\",SimSun,serif;font-weight:600}h1{font-size:28px;margin:2px 0}\nh2{font-size:20px;margin:0 0 12px}p{margin:8px 0}.eyebrow{color:var(--foam);font-size:12px;letter-spacing:.16em}\n.serial{font:12px/1.6 ui-monospace,Consolas,monospace;color:var(--copper)}\n.instrument{display:grid;grid-template-columns:1.2fr 1fr;gap:28px;align-items:center;padding:26px 0}\n.dial{border:1px solid #be925b88;border-radius:50%;aspect-ratio:1;max-width:250px;display:grid;align-content:center;text-align:center;\nbackground:repeating-conic-gradient(from -1deg,#be925b66 0deg 1deg,transparent 1deg 30deg);position:relative;padding:30px}\n.dial:before{content:\"\";position:absolute;inset:12px;background:var(--sea);border:1px solid #be925b44;border-radius:50%}\n.dial>*{z-index:1}.clock{font:48px/1.2 ui-monospace,Consolas,monospace;font-variant-numeric:tabular-nums;letter-spacing:-.05em}\n.caption,.hint{color:#c2d3ca;font-size:13px}.measure{font-size:28px;font-variant-numeric:tabular-nums;color:var(--foam)}\n.scale{height:8px;background:#edf0dd22;margin:10px 0;border-right:3px solid var(--alarm)}.scale span{display:block;height:100%;background:var(--copper);width:0}\n.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;border-top:1px solid #be925b66;border-bottom:1px solid #be925b66}\n.metric{padding:16px 10px 16px 0}.metric+.metric{border-left:1px solid #be925b44;padding-left:16px}.metric strong{display:block;font-size:22px}\n.label{font-size:12px;color:var(--foam)}.ledger{padding:18px 0;border-bottom:1px solid #be925b44}.ledger p{white-space:pre-wrap}\n.columns{display:grid;grid-template-columns:1fr 1fr;gap:28px}.tools{padding-top:24px}.tools section{margin-bottom:24px}\nlabel{display:block;margin:10px 0 6px}input,textarea{width:100%;min-height:44px;padding:10px;border:1px solid #8fc8c377;border-radius:2px;\nbackground:#0b2029;color:var(--paper);font:inherit}textarea{resize:vertical;min-height:86px}\nbutton{min-height:44px;padding:10px 15px;border:1px solid var(--copper);border-radius:2px;background:var(--copper);color:#11252e;\nfont:600 14px/1.5 system-ui,sans-serif;cursor:pointer;margin:10px 8px 0 0;transition:transform .12s,background .12s}\nbutton.secondary{background:transparent;color:var(--paper)}button:active{transform:translateY(1px)}button:disabled{opacity:.5;cursor:wait}\nbutton:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid var(--foam);outline-offset:3px}\n.feedback{font-size:13px;min-height:22px;color:var(--foam)}.warning{color:#f0b19a}.paper{white-space:pre-wrap;background:#edf0dd0a;padding:12px;border-left:2px solid var(--copper)}\ndetails{border-top:1px solid #be925b66;padding-top:16px}summary{cursor:pointer;min-height:44px;font:600 20px/44px SimSun,serif}\nfooter{border-top:1px solid #be925b44;padding-top:16px;font-size:12px;color:#c2d3ca}\n@media(max-width:600px){.watch{padding:18px}.instrument,.columns{grid-template-columns:1fr}.instrument{gap:16px}.dial{margin:auto;width:220px}\nheader{display:block}.grid{grid-template-columns:1fr}.metric+.metric{border-left:0;border-top:1px solid #be925b44;padding-left:0}h1{font-size:25px}}\n@media(prefers-reduced-motion:reduce){button{transition:none}button:active{transform:none}}\n</style></head><body><main class=\"watch\">\n<header><div><div class=\"eyebrow\">MICHIO HARBOUR · NIGHT WATCH</div><h1>弥潮港 · 港口值班台</h1></div><div class=\"serial\">归港修复所<br>第十三声之前 / 值守记录</div></header>\n<div class=\"instrument\"><div class=\"dial\" aria-label=\"潮钟\"><div class=\"eyebrow\">潮钟 / 当前时刻</div><div class=\"clock\" id=\"watch-clock\">—:—</div><div class=\"caption\" id=\"watch-day\">等待读取</div></div>\n<div><div class=\"label\">最近测得潮压</div><div class=\"measure\" id=\"watch-pressure\">— / 100</div><div class=\"scale\" aria-hidden=\"true\"><span id=\"pressure-bar\"></span></div>\n<p class=\"hint\">潮压警戒刻度：80 / 100。</p><div class=\"label\">当前位置</div><p id=\"watch-place\">等待读取</p></div></div>\n<div class=\"grid\"><div class=\"metric\"><span class=\"label\">铜齿币</span><strong id=\"watch-coins\">—</strong></div><div class=\"metric\"><span class=\"label\">随身灯电荷</span><strong id=\"watch-charge\">—</strong></div><div class=\"metric\"><span class=\"label\">潮蚀记录</span><strong id=\"watch-erosion\">—</strong></div></div>\n<p class=\"feedback\" id=\"watch-observation\" role=\"status\">等待当前数值。</p>\n<section class=\"ledger\"><h2>随身物资</h2><p id=\"watch-inventory\">等待读取</p></section>\n<section class=\"ledger\"><h2>证据簿</h2><p id=\"watch-evidence\">等待读取</p></section>\n<div class=\"columns\"><section class=\"ledger\"><h2>人物联络</h2><p id=\"watch-contacts\">等待读取</p></section>\n<section class=\"ledger\"><h2>路线记录</h2><p id=\"watch-routes\">等待读取</p></section></div>\n<div class=\"tools columns\"><section><h2>人工校准</h2><p class=\"hint\">手动调整随身灯电荷读数。</p>\n<label for=\"calibration-value\">随身灯电荷（0 至 100）</label><input id=\"calibration-value\" type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"100\">\n<button id=\"calibration-save\" type=\"button\">确认人工校准</button><p class=\"feedback\" id=\"calibration-status\" role=\"status\"></p></section>\n<section><h2>个人值班记录</h2><label for=\"log-input\">值班记录内容</label><textarea id=\"log-input\" placeholder=\"例如：下一次核对原件时，记住询问缺角的去向。\"></textarea>\n<button id=\"log-save\" type=\"button\">保存值班记录</button><p class=\"feedback\" id=\"log-status\" role=\"status\"></p><p class=\"paper\" id=\"latest-log\">尚无值班记录。</p></section></div>\n<details><summary>世界书 · 个人笔记</summary><p class=\"hint\">将观察保存到当前世界书，提到“值班台个人笔记”时即可翻阅。</p>\n<label for=\"note-input\">新增笔记</label><textarea id=\"note-input\" placeholder=\"写下需要保留的个人观察，并区分事实与推测。\"></textarea>\n<button id=\"note-add\" type=\"button\">新增个人笔记</button><button class=\"secondary\" id=\"note-delete\" type=\"button\">删除本值班台全部个人笔记</button>\n<p class=\"feedback\" id=\"note-status\" role=\"status\"></p><p class=\"paper\" id=\"note-list\">等待读取。</p></details>\n<details><summary>独立顾问问答（调用模型）</summary><p class=\"warning\">每次点击调用1次模型，提供线索核对与解释参考。</p>\n<label for=\"consult-question\">给顾问的问题（请附上需要核对的线索）</label><textarea id=\"consult-question\" placeholder=\"例如：这两份证词可能有哪些解释？请列出仍需核实的地方。\"></textarea>\n<button id=\"consult-send\" type=\"button\">调用独立顾问</button><p class=\"feedback\" id=\"consult-status\" role=\"status\"></p><div class=\"paper\" id=\"consult-reply\" aria-live=\"polite\">尚未调用顾问。</div></details>\n<footer>港口读数与值班记录。准备行动时，在对话中说明你的决定。</footer>\n</main><script>const clock=document.getElementById('watch-clock');\nconst day=document.getElementById('watch-day');\nconst pressure=document.getElementById('watch-pressure');\nconst pressureBar=document.getElementById('pressure-bar');\nconst place=document.getElementById('watch-place');\nconst coins=document.getElementById('watch-coins');\nconst charge=document.getElementById('watch-charge');\nconst erosion=document.getElementById('watch-erosion');\nconst inventory=document.getElementById('watch-inventory');\nconst evidence=document.getElementById('watch-evidence');\nconst contacts=document.getElementById('watch-contacts');\nconst routes=document.getElementById('watch-routes');\nconst observation=document.getElementById('watch-observation');\nconst calibration=document.getElementById('calibration-value');\nconst calibrationButton=document.getElementById('calibration-save');\nconst calibrationStatus=document.getElementById('calibration-status');\nconst logInput=document.getElementById('log-input');\nconst logButton=document.getElementById('log-save');\nconst logStatus=document.getElementById('log-status');\nconst latestLog=document.getElementById('latest-log');\nconst noteInput=document.getElementById('note-input');\nconst noteAdd=document.getElementById('note-add');\nconst noteDelete=document.getElementById('note-delete');\nconst noteStatus=document.getElementById('note-status');\nconst noteList=document.getElementById('note-list');\nconst questionInput=document.getElementById('consult-question');\nconst consultButton=document.getElementById('consult-send');\nconst consultStatus=document.getElementById('consult-status');\nconst consultReply=document.getElementById('consult-reply');\n\nfunction appendDutyLog(role,text){\n  const variables=getVariables({type:'chat'});\n  const previous=variables['author.log'];\n  const entries=previous&&Array.isArray(previous.entries)?previous.entries:\n    previous&&previous.text?[{role:previous.role||'note',text:previous.text}]:[];\n  insertOrAssignVariables({'author.log':{schemaVersion:1,entries:[...entries,{role,text}]}},{type:'chat'});\n}\nfunction render(){\n  const state=NextTavern.getNumericalState();\n  const available=state.kind==='ready'||state.kind==='schema-ready';\n  calibrationButton.disabled=!available||!state.canEdit;\n  if(!available){\n    observation.textContent='等待数值同步（'+state.code+'）。当前显示上次记录。';\n    return;\n  }\n  const values=state.values;\n  const hours=Math.floor(values.port.minutes/60);\n  const minutes=values.port.minutes%60;\n  clock.textContent=String(hours).padStart(2,'0')+':'+String(minutes).padStart(2,'0');\n  day.textContent='归港第 '+String(values.port.day)+' 日 · 十二潮刻制';\n  pressure.textContent=String(values.port.tide_pressure)+' / 100';\n  pressureBar.style.setProperty('width',String(values.port.tide_pressure)+'%');\n  place.textContent=values.port.location;\n  coins.textContent=String(values.resources.coins)+' 枚';\n  charge.textContent=String(values.resources.charge)+' / 100';\n  erosion.textContent=String(values.resources.erosion)+' 级';\n  inventory.textContent=Object.entries(values.inventory).map(row=>row[0]+' × '+String(row[1])).join(' · ');\n  evidence.textContent=values.investigation.evidence.length?values.investigation.evidence.join('；'):'证据簿尚空。';\n  contacts.textContent=Object.entries(values.contacts).map(row=>row[0]+'：'+row[1]).join('；');\n  routes.textContent=Object.entries(values.routes).map(row=>row[0]+'：'+row[1]).join('；');\n  observation.textContent=state.canEdit?'值班读数已同步。潮压警戒刻度：80。':\n    '当前只读：'+String(state.editBlockCode||'编辑暂不可用');\n  const variables=getVariables({type:'chat'});\n  const log=variables['author.log'];\n  latestLog.textContent=log&&Array.isArray(log.entries)?log.entries.map(entry=>\n    (entry.role==='note'?'观察':entry.role==='user'?'顾问提问':'顾问答复')+'：'+entry.text).join('\\n\\n'):\n    log&&log.text?String(log.text):'尚无值班记录。';\n}\nfunction renderNotes(){\n  const name=getCurrentCharPrimaryLorebook();\n  const rows=getWorldbook(name).filter(entry=>entry.name==='【雾港值班台·个人笔记】'&&\n    entry.extra&&entry.extra.owner==='steam-tide-duty-notes-v1');\n  noteList.textContent=rows.length?rows.map(entry=>entry.content).join('\\n\\n'):'本值班台尚未创建个人笔记。';\n}\n\ncalibrationButton.addEventListener('click',async()=>{\n  const state=NextTavern.getNumericalState();\n  if((state.kind!=='ready'&&state.kind!=='schema-ready')||!state.canEdit){\n    calibrationStatus.textContent='当前数值不可编辑，请等待状态恢复。';return;\n  }\n  const value=Number(calibration.value);\n  if(!calibration.value.trim()||!Number.isFinite(value)||value<0||value>100){\n    calibrationStatus.textContent='请输入 0 至 100 的电荷。';return;\n  }\n  const complete=JSON.parse(JSON.stringify(state.values));\n  complete.resources.charge=value;\n  calibrationButton.disabled=true;\n  calibrationStatus.textContent='正在提交人工校准……';\n  try{\n    const reply=await NextTavern.replaceNumericalValues(complete,state.expected);\n    calibrationStatus.textContent=reply.ok?'电荷已校准。':\n      '校准未提交：'+String(reply.operation&&reply.operation.refusalCode||'请刷新后重新确认');\n  }catch(error){calibrationStatus.textContent='校准未确认：'+String(error);}\n  render();\n});\nlogButton.addEventListener('click',()=>{\n  const text=logInput.value.trim();\n  if(!text){logStatus.textContent='请先填写记录。';return;}\n  try{\n    appendDutyLog('note',text);\n    logStatus.textContent='已保存观察。';render();\n  }catch(error){logStatus.textContent='记录未保存：'+String(error);}\n});\nnoteAdd.addEventListener('click',async()=>{\n  const text=noteInput.value.trim();\n  if(!text){noteStatus.textContent='请先填写个人笔记。';return;}\n  noteAdd.disabled=true;\n  try{\n    const name=getCurrentCharPrimaryLorebook();\n    const reply=await createWorldbookEntries(name,[{\n      name:'【雾港值班台·个人笔记】',enabled:true,\n      strategy:{type:'selective',keys:['值班台个人笔记'],keys_secondary:{logic:'and_any',keys:[]},scan_depth:'same_as_global'},\n      position:{type:'after_character_definition',order:180},\n      recursion:{prevent_incoming:true,prevent_outgoing:true},\n      content:'个人笔记：'+text,\n      extra:{owner:'steam-tide-duty-notes-v1'}\n    }]);\n    noteStatus.textContent='已写入当前绑定世界书 '+name+'，新增 '+String(reply.new_entries.length)+' 条。';\n    renderNotes();\n  }catch(error){noteStatus.textContent='个人笔记未保存：'+String(error);}\n  noteAdd.disabled=false;\n});\nnoteDelete.addEventListener('click',async()=>{\n  noteDelete.disabled=true;\n  try{\n    const name=getCurrentCharPrimaryLorebook();\n    const reply=await deleteWorldbookEntries(name,entry=>entry.name==='【雾港值班台·个人笔记】'&&\n      entry.extra&&entry.extra.owner==='steam-tide-duty-notes-v1');\n    noteStatus.textContent='已删除本值班台创建的 '+String(reply.deleted_entries.length)+' 条个人笔记。';\n    renderNotes();\n  }catch(error){noteStatus.textContent='删除未确认：'+String(error);}\n  noteDelete.disabled=false;\n});\nconsultButton.addEventListener('click',async()=>{\n  const question=questionInput.value.trim();\n  if(!question){consultStatus.textContent='请先填写顾问问题。';return;}\n  consultButton.disabled=true;\n  consultStatus.textContent='顾问正在整理问题。';\n  try{\n    appendDutyLog('user',question);\n    const text=await generateRaw({should_silence:true,max_chat_history:0,ordered_prompts:[\n      'world_info_before','char_description','char_personality','scenario','world_info_after',\n      {role:'system',content:'你是玩家调用的独立调查顾问。根据问题与所附材料，整理事实、可能解释与待核实事项，清楚标注来源，给出简洁的调查参考。'},\n      {role:'user',content:question}\n    ]});\n    consultReply.textContent=text;\n    consultStatus.textContent='顾问回答已返回。';\n    appendDutyLog('assistant',text);\n    render();\n  }catch(error){consultStatus.textContent='顾问请求或记录未完成：'+String(error)+'。可明确点击重试。';}\n  consultButton.disabled=false;\n});\nrender();\ntry{renderNotes();}catch(error){noteStatus.textContent='世界书暂不可读：'+String(error);}\neventOn(tavern_events.MESSAGE_UPDATED,render);\neventOn(tavern_events.MESSAGE_RECEIVED,render);\neventOn(tavern_events.MESSAGE_SWIPED,render);\neventOn(tavern_events.SETTINGS_UPDATED,render);\n</script></body></html>"
            }
          },
          {
            "id": "steam-port-brief-hook",
            "name": "港务简报口径",
            "type": "script",
            "enabled": true,
            "content": "const BRIEF_ID='steam-port-brief';\nfunction portBrief(){\n  uninjectPrompts([BRIEF_ID]);\n  const latest=getChatMessages(-1)[0];\n  if(latest&&latest.role==='user'&&latest.message.includes('提交值班简报')){\n    const values=getVariables({type:'message',message_id:-2}).stat_data;\n    injectPrompts([{id:BRIEF_ID,position:'in_chat',depth:0,role:'system',should_scan:false,\n      content:'【弥潮港·值班简报】本轮采用简短港务报告：时刻、地点、已完成工作、待查事项。当前值班地点：'\n        +values.port.location+'；电荷：'+String(values.resources.charge)+'。'}],{once:true});\n  }\n}\neventOn(tavern_events.GENERATION_AFTER_COMMANDS,portBrief);\nwindow.addEventListener('pagehide',()=>uninjectPrompts([BRIEF_ID]));"
          }
        ]
      },

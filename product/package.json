{
  "name": "dsh-nexttavern",
  "version": "0.3.0-rc.1",
  "description": "DeepSeek Harness 长篇角色扮演插件，支持导入与创作角色卡、作者自定义界面、世界书、世界线、长期记忆和原稿导出。在运行中的 Harness 首次安装后，重启即可启用。",
  "keywords": [
    "dsh-nexttavern",
    "dsh-plugin",
    "deepseek-harness",
    "roleplay",
    "character-card",
    "tavern",
    "sillytavern",
    "ai-roleplay",
    "long-form-roleplay"
  ],
  "homepage": "https://a86582751.github.io/dsh-nexttavern/",
  "bugs": {
    "url": "https://github.com/a86582751/dsh-nexttavern/issues"
  },
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5"
  },
  "main": "lib/operations/nexttavern-entry.mjs",

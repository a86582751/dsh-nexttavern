    ".": {
      "default": "./lib/operations/nexttavern-entry.mjs"
    },
    "./entry-policy": {
      "default": "./lib/operations/nexttavern-entry-policy.mjs"
    },
    "./host": {
      "default": "./lib/core/host-index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a86582751/dsh-nexttavern.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.json"

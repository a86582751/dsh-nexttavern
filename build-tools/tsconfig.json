{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "preserveSymlinks": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "paths": {
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "dsh-nexttavern-pi-ai": [
        "./node_modules/@earendil-works/pi-ai/dist/index.d.ts"
      ],
      "dsh-nexttavern-pi-ai/*": [
        "./node_modules/@earendil-works/pi-ai/dist/*"
      ],
      "dsh-nexttavern-session-format": [
        "../development/session-format/src/index.ts"
      ],
      "dsh-nexttavern-session-format/*": [
        "../development/session-format/src/*.ts"
      ],
      "dsh-nexttavern-mvu-schema-runtime-v4-update-batch-v1": [
        "../development/mvu-schema-runtime-v4-update-batch-v1/src/index.ts"
      ],
      "dsh-nexttavern-mvu-schema-runtime-v4-update-batch-v1/*": [
        "../development/mvu-schema-runtime-v4-update-batch-v1/src/*.ts"
      ],
      "parse5": [
        "./node_modules/parse5/dist/index.d.ts"
      ],
      "dsh-nexttavern-anydoc/*": [
        "../development/anydoc/src/*.ts"
      ],
      "dsh-nexttavern-typescript-runtime": [
        "../development/typescript-runtime/src/index.ts"
      ]
    },
    "newLine": "lf"
  }
}

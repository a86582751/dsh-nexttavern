{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh-roleplay/message-edit/v1",
  "title": "Required roleplay/message-edit event payload",
  "type": "object",
  "required": ["schemaVersion", "targetSeq", "messageId", "role", "text"],
  "properties": {
    "schemaVersion": {"const": 1},
    "targetSeq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "messageId": {"type": "string", "minLength": 1},
    "role": {"enum": ["user", "assistant"]},
    "text": {"type": "string", "maxLength": 1000000}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexttavern:card:1.2",
  "title": "NextTavern portable character card 1.2",
  "description": "DATA owns the single current author body. Optional classification binds semantic coordinates to that body. Advanced views are derived at runtime. ARCHIVE retains original sources. Open author metadata remains portable; runtime permissions and session state belong to their runtime owners.",
  "type": "object",
  "required": ["spec", "spec_version", "data", "archive"],
  "additionalProperties": true,
  "properties": {
    "spec": {"const": "nexttavern_card"},
    "spec_version": {"const": "1.2"},
    "classification": {"$ref": "#/$defs/classification"},
    "data": {
      "type": "object",
      "required": ["name", "cards", "worldbook", "rules"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "cards": {"type": "array", "items": {"$ref": "#/$defs/authorRow"}},
        "worldbook": {"type": "array", "items": {"$ref": "#/$defs/authorRow"}},
        "rules": {"$ref": "#/$defs/rulesRow"},
        "status": {"$ref": "#/$defs/textRow"},
        "opening": {
          "allOf": [{"$ref": "#/$defs/textRow"}],
          "properties": {
            "materialization": {"enum": ["template", "materialized"]},
            "catalog": {
              "type": "array",
              "items": {"type": "object", "required": ["rawText"], "additionalProperties": true,
                "properties": {"rawText": {"type": "string"}, "label": {"type": "string"}}}
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "sillytavernMacroFields": {
              "description": "Activated ST macro aliases retained independently of canonical author prose; expanded only by the existing protected prompt renderer.",
              "type": "object",
              "additionalProperties": {"type": "string"}
            }
          }
        },
        "settings": {"type": "object", "additionalProperties": true},
        "extensions": {
          "description": "Current author extensions. TavernHelper scripts, regex_scripts and RubyAnalyzer are consumed by their respective runtime owners. Unknown fields are preserved. Live journals, model routes and execution permissions remain runtime-owned.",
          "type": "object",
          "additionalProperties": true
        },
        "assets": {"type": "array", "description": "Author resource declarations with their original addresses and metadata. Availability is resolved by the resource owner."},
        "character_book": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "entries": {
              "description": "Retains original array order or object keys, complete entry content and unknown fields. Current editor changes are merged by the export producer.",
              "oneOf": [
                {"type": "array", "items": {"$ref": "#/$defs/bookEntry"}},
                {"type": "object", "additionalProperties": {"$ref": "#/$defs/bookEntry"}}
              ]
            }
          }
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "documents": {"type": "array"},
        "classifiedSources": {"type": "array"}
      }
    }
  },
  "$defs": {
    "classification": {
      "description": "Program-owned source coordinates and semantic assignments. The runtime checks them against current DATA before deriving advanced material. Missing or stale classification leaves ordinary author execution available.",
      "type": "object",
      "required": ["schemaVersion", "encoding", "sourceSha256", "characters", "assignments", "sources"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {"const": 1},
        "encoding": {"const": "nexttavern-classification-v1"},
        "sourceSha256": {"$ref": "#/$defs/sha256"},
        "characters": {"type": "array", "items": {
          "type": "object", "required": ["id", "name"], "additionalProperties": false,
          "properties": {
            "id": {"$ref": "#/$defs/characterId"}, "name": {"type": "string", "minLength": 1},
            "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }},
        "assignments": {"type": "array", "items": {
          "type": "object", "required": ["sourceId", "startLine", "endLine", "target"], "additionalProperties": false,
          "properties": {
            "sourceId": {"type": "string"},
            "startLine": {"type": "integer", "minimum": 1},
            "endLine": {"type": "integer", "minimum": 1},
            "target": {"enum": ["character", "core", "plot", "narrative", "reply", "style", "other"]},
            "characterId": {"$ref": "#/$defs/characterId"}
          },
          "if": {"properties": {"target": {"const": "character"}}},
          "then": {"required": ["characterId"]},
          "else": {"not": {"required": ["characterId"]}}
        }},
        "sources": {"type": "array", "items": {
          "type": "object", "required": ["id", "pointer", "sha256", "lineCount", "kind", "atomic"], "additionalProperties": false,
          "properties": {
            "id": {"type": "string"},
            "pointer": {"type": "string", "pattern": "^/data/"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "lineCount": {"type": "integer", "minimum": 1},
            "kind": {"enum": ["author", "worldbook"]},
            "atomic": {"type": "boolean"}
          }
        }}
      }
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "characterId": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
    "rulesRow": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "core": {"type": "string"},
        "plot": {"type": "string"},
        "narrative": {"type": "string"},
        "reply": {"type": "string"},
        "style": {"type": "string"},
        "status": {"type": "string"},
        "beauty": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "css": {"type": "string"},
            "js": {"type": "string"},
            "regexRules": {"type": "array"}
          }
        }
      }
    },
    "authorRow": {
      "description": "Open author fields are preserved. Reserved local runtime fields (id, schemaVersion, version, updatedAt, updatedAtSeq, createdAt, importId, sources, verified, tavern and beauty.sources) are not portable execution permissions and are removed by export and activation.",
      "type": "object",
      "required": ["content"],
      "additionalProperties": true,
      "properties": {
        "content": {"type": "string"},
        "characterId": {"$ref": "#/$defs/characterId"},
        "enabled": {"type": "boolean"},
        "name": {"type": "string"},
        "kind": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "triggers": {"type": "array", "items": {"type": "string"}},
        "locked": {"type": "boolean"},
        "priority": {"type": "number"},
        "tokenBudget": {"type": "number"},
        "alwaysOn": {"type": "boolean"}
      }
    },
    "textRow": {
      "description": "Current authored text and portable author metadata. Local runtime identities, provenance and verification are not portable execution permissions.",
      "type": "object",
      "required": ["text"],
      "additionalProperties": true,
      "properties": {"text": {"type": "string"}}
    },
    "bookEntry": {
      "type": "object",
      "required": ["content"],
      "additionalProperties": true,
      "properties": {"content": {"type": "string"}}
    }
  }
}
